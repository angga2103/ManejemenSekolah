# ==============================================================================
# MULTI-STAGE DOCKERFILE FOR NESTJS BACKEND API (apps/api)
# ==============================================================================

# Stage 1: Build & Dependencies
FROM node:20-alpine AS builder
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache libc6-compat

# Copy package manifests
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/api-contracts/package.json ./packages/api-contracts/
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN npm ci

# Copy source files
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Build shared packages & Prisma client
RUN npm run build --workspace=packages/shared-types
RUN npm run build --workspace=packages/api-contracts
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma

# Build NestJS API
RUN npm run build --workspace=apps/api

# Stage 2: Hardened Production Runtime
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 edusaas

# Copy runtime artifacts
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/packages/api-contracts/dist ./packages/api-contracts/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

USER edusaas
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/v1/health || exit 1

CMD ["node", "apps/api/dist/main.js"]
