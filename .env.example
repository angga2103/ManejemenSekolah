# ==============================================================================
# INTEGRATED SCHOOL & PESANTREN MANAGEMENT SAAS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# WARNING: Never commit actual credentials, private keys, or passwords.
# Copy this file to .env and configure values appropriate for your environment.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME="Integrated School & Pesantren Management"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Standard Application Connection (Enforces Row-Level Security where configured)
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/edusaas_dev?schema=public&sslmode=prefer"

# Direct URL for migrations (bypasses pgbouncer / pooled connections)
DIRECT_URL="postgresql://postgres:postgres_dev_password@localhost:5432/edusaas_dev?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=edusaas_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. REDIS & BACKGROUND QUEUES (BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_DB=0
REDIS_URL="redis://:redis_dev_password@localhost:6379/0"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & TOKENS (JWT & Refresh Token Rotation)
# ------------------------------------------------------------------------------
# Generate cryptographically strong secrets in production (e.g., openssl rand -hex 64)
JWT_ACCESS_SECRET="dev_access_secret_do_not_use_in_production_min_length_32_chars_12345"
JWT_ACCESS_EXPIRATION="15m"

JWT_REFRESH_SECRET="dev_refresh_secret_do_not_use_in_production_min_length_32_chars_67890"
JWT_REFRESH_EXPIRATION="7d"

# QR Code Attendance Signing Key (Ed25519 or HMAC SHA-256 for offline verification)
ATTENDANCE_QR_SIGNING_SECRET="dev_attendance_qr_secret_key_32_bytes_min_123456"

# Password Hashing Salt Rounds
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (S3-Compatible / MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="minio_dev_password_123"
S3_BUCKET_NAME="edusaas-documents"
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 6. PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="edusaas-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@edusaas-dev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY SANDBOX (Midtrans / Xendit / Mock)
# ------------------------------------------------------------------------------
# Set to 'mock' for local offline development; 'sandbox' for staging; 'production' for live
PAYMENT_PROVIDER="mock"
PAYMENT_MERCHANT_ID="mock_merchant_id"
PAYMENT_SERVER_KEY="mock_server_key"
PAYMENT_CLIENT_KEY="mock_client_key"
PAYMENT_CALLBACK_SECRET="mock_webhook_secret"

# ------------------------------------------------------------------------------
# 8. AUDIT & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL="debug"
AUDIT_LOG_RETENTION_DAYS=365
ENABLE_QUERY_LOGGING=true
